<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsFormsAnalyzers>false</EnableWindowsFormsAnalyzers>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BaChen AI Launcher</AssemblyName>
    <Product>BaChen AI Launcher</Product>
    <Company>Bachen</Company>
    <Authors>Bachen</Authors>
    <Copyright>Copyright (c) 2026 Bachen</Copyright>
    <RepositoryUrl>https://github.com/Bachen-beep/bachen-ai-launcher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>0.15.0</Version>
    <AssemblyVersion>0.15.0.0</AssemblyVersion>
    <FileVersion>0.15.0.0</FileVersion>
    <InformationalVersion>0.15.0-stage5</InformationalVersion>
    <ApplicationIcon>Assets\BaChenLauncherIcon.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Security\launcher-update-public.pem" LogicalName="BaChenAiLauncher.UpdatePublicKey" />
    <EmbeddedResource Include="Security\plugin-index-public.pem" LogicalName="BaChenAiLauncher.PluginIndexPublicKey" />
    <EmbeddedResource Include="Catalog\plugin-index.json" LogicalName="BaChenAiLauncher.BundledPluginIndex" />
  </ItemGroup>
</Project>
