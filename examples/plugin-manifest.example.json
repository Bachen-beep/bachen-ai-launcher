{
  "schemaVersion": 5,
  "id": "example-image-plugin",
  "displayName": "Example Image Plugin",
  "version": "1.0.0",
  "publisher": "Example Publisher",
  "category": "Image generation",
  "description": "Example signed plugin package for BaChen AI Launcher.",
  "executable": "runtime/python.exe",
  "arguments": "app.py --host 127.0.0.1 --port {port}",
  "runtime": "python",
  "runtimeVersion": ">=3.10,<3.13",
  "port": 7870,
  "recommendedVramMiB": 6144,
  "recommendedSystemMemoryMiB": 16384,
  "isHighVram": false,
  "requiredFiles": [
    "app.py",
    "runtime/python.exe"
  ],
  "dependencies": [
    "cuda",
    "file:app.py"
  ],
  "gitHubRepository": "owner/repository",
  "gitHubBranch": "main",
  "packageUrl": "https://example.com/example-image-plugin-1.0.0.zip",
  "packageMirrors": [
    "https://mirror.example.com/example-image-plugin-1.0.0.zip"
  ],
  "packageSha256": "REPLACE_WITH_64_CHARACTER_SHA256",
  "packageSizeBytes": 123456789,
  "preservedPaths": [
    "models",
    "outputs",
    "config/user.json"
  ],
  "licenseName": "Example Model License",
  "licenseUrl": "https://example.com/license",
  "requiresLicenseAcceptance": true,
  "createVirtualEnvironment": true,
  "virtualEnvironmentPath": ".venv",
  "requirementsFile": "requirements.txt",
  "minimumFreeDiskBytes": 2147483648,
  "requiresExternalAuthorization": true,
  "modelProvider": "huggingface",
  "modelId": "publisher/gated-model",
  "authorizationUrl": "https://huggingface.co/publisher/gated-model",
  "authorizationProbePath": "config.json",
  "signature": {
    "keyId": "example-publisher-2026",
    "algorithm": "RSA-SHA256",
    "value": "REPLACE_WITH_BASE64_SIGNATURE"
  }
}
